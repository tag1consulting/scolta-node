{
  "name": "scolta",
  "version": "1.0.1",
  "description": "AI-powered search with Pagefind — Node/TypeScript language binding",
  "license": "MIT",
  "author": "Tag1 Consulting <info@tag1.com>",
  "homepage": "https://tag1.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tag1consulting/scolta-node.git"
  },
  "bugs": {
    "url": "https://github.com/tag1consulting/scolta-node/issues"
  },
  "keywords": [
    "search",
    "ai",
    "pagefind",
    "wasm",
    "scoring"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "adapter": [
        "./dist/adapter.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./adapter": {
      "import": {
        "types": "./dist/adapter.d.ts",
        "default": "./dist/adapter.js"
      },
      "require": {
        "types": "./dist/adapter.d.cts",
        "default": "./dist/adapter.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsup --config tsup.adapter.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:publish": "publint && attw --pack .",
    "check:pack": "node scripts/check-pack-contents.mjs"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.0.0",
    "entities": "^4.5.0",
    "marked": "^12.0.0",
    "parse5": "^7.1.2",
    "proper-lockfile": "^4.1.2"
  },
  "peerDependencies": {
    "pagefind": "^1.3.0"
  },
  "peerDependenciesMeta": {
    "pagefind": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.11.0",
    "@types/proper-lockfile": "^4.1.4",
    "eslint": "^9.0.0",
    "publint": "^0.3.21",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.6"
  }
}
